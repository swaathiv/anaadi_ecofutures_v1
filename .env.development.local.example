# Copy to .env.development.local (used only by `npm run dev`) for local development against the Firebase emulators.
NEXT_PUBLIC_FIREBASE_API_KEY=demo-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-anaadi.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-anaadi
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
NEXT_PUBLIC_FIREBASE_USE_EMULATORS=true
