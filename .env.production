# Firebase web config for the anaadi-ecofutures project (used by `npm run build`).
# These values are public by design: they identify the project; access is
# enforced by firestore.rules and the Cloud Functions. Override locally with
# .env.production.local if needed.
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyDeWGa3yzgYRHw6V-W59ne2ZqSoui-9-Is
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=anaadi-ecofutures.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=anaadi-ecofutures
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=anaadi-ecofutures.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=429472422926
NEXT_PUBLIC_FIREBASE_APP_ID=1:429472422926:web:5d1100f9e445674d5a705f
NEXT_PUBLIC_FIREBASE_FUNCTIONS_REGION=asia-south1

# Online ordering. Keep "false" until `npm run deploy` has deployed the order
# Cloud Functions (needs the Blaze plan); then change to "true" and run
# `npm run deploy:site`.
NEXT_PUBLIC_ORDERING_ENABLED=false
