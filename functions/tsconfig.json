{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2023"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "lib",
    "rootDir": "..",
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "../lib/pricing.ts", "../lib/types.ts", "../lib/validation.ts"]
}
