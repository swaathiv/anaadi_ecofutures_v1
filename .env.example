# The live values are in .env.production. To use a different project, copy
# this to .env.production.local and fill in from
# Firebase console → Project settings → Your apps → Web app → SDK setup.
# These values are public by design; security comes from firestore.rules
# and the Cloud Functions.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Must match setGlobalOptions({ region }) in functions/src/index.ts.
NEXT_PUBLIC_FIREBASE_FUNCTIONS_REGION=asia-south1

# Public contact email shown on the site. Set empty to hide.
NEXT_PUBLIC_CONTACT_EMAIL=info@anaadiecofutures.com

# Local development: put emulator settings in .env.development.local, not
# .env.local, so they never reach a production build. See README.

