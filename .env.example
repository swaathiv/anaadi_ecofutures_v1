# Absolute or relative directory for the local JSON data store (accounts,
# sessions, orders). Defaults to ./.data. Must be on persistent disk.
DATA_DIR=.data

# Comma-separated emails allowed to open /admin/orders and update order status.
ADMIN_EMAILS=

# Public contact email shown on the site. Defaults to the address published
# on the previous anaadiecofutures.com site. Set to empty to hide it.
NEXT_PUBLIC_CONTACT_EMAIL=info@anaadiecofutures.com
